# Both values below are PUBLIC (safe to commit in your own fork) — no client secret is
# used by the browser flow. Create them at https://console.cloud.google.com/apis/credentials:
#   1. Enable the "Google Sheets API" and the "Google Picker API".
#   2. Create Credentials → OAuth client ID → Application type: Web application.
#      Add an Authorized JavaScript origin: http://localhost:5173
#      (and later your GitHub Pages URL, e.g. https://<you>.github.io).
#   3. Create Credentials → API key (used by the Picker). Recommended: restrict it to
#      your origins and to the Google Picker API.

# OAuth Web client ID.
VITE_GOOGLE_CLIENT_ID=

# API key for the Google Picker (the "choose your spreadsheet" dialog).
VITE_GOOGLE_API_KEY=

# Optional: pre-fill the Google Sheet URL so you don't paste it each time.
VITE_SHEET_URL=

# Optional: electricity unit rate (currency per meter unit). Default: 15
VITE_UNIT_RATE=15
